{
  "name": "sites-project",
  "version": "0.5.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:brand": "node scripts/build-brand-assets.mjs",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint app lib public components hooks stories --deny-warnings",
    "format": "oxfmt",
    "test": "node --test lib/*.test.mjs tests/account-access.test.mjs tests/virtual-gym.test.mjs",
    "test:rules": "npx --yes --package firebase-tools@15.34.1 firebase emulators:exec --only firestore --project demo-workout-tracker \"node --test tests/firestore-rules.test.mjs\"",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "typecheck": "tsc --project tsconfig.app.json --pretty false --incremental false"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@tanstack/react-query": "5.105.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "firebase": "12.19.0",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "19.3.1",
    "react-day-picker": "9.8.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.3.1",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261026.1",
    "@firebase/rules-unit-testing": "5.0.2",
    "@openai/sites-vite-plugin": "0.2.0",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.37",
    "fake-indexeddb": "6.2.6",
    "happy-dom": "21.0.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.22.1",
    "sharp": "0.35.5",
    "storybook": "10.6.2",
